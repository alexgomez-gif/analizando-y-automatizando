---
import {
	ChevronRight,
	ClipboardCheck,
	Combine,
	FileSpreadsheet,
	Files,
	LayoutDashboard,
	MessageCircle,
	Plus,
	Quote,
	TrendingUp,
	Workflow,
} from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import EnlaceFlecha from "../components/EnlaceFlecha.astro";
import Seccion from "../components/Seccion.astro";
// Textos de docs/contenido.md (Inicio, aprobados).
// Pendientes fuera de este plan: calculadora de ahorro (plan propio) y demos (ocultas hasta la Fase 6).

// «Cómo trabajamos»: la tubería muestra el método; los pasos, el camino del cliente.
const etapas = ["Datos", "Limpieza", "Análisis", "Automatización", "Decisión"];
const pasos = [
	{
		titulo: "Diagnóstico gratis",
		texto: "Conversamos 30 minutos, revisamos tus datos y en 3 días hábiles te entregamos un informe con lo que conviene automatizar.",
	},
	{
		titulo: "Propuesta clara",
		texto: "Te enviamos un plan con lo que vamos a hacer, cuánto tarda y cuánto cuesta. Sin letra pequeña.",
	},
	{
		titulo: "Construcción",
		texto: "Armamos la solución con las herramientas que ya usas, siempre que se pueda.",
	},
	{
		titulo: "Entrega y acompañamiento",
		texto: "Te capacitamos, te dejamos un manual y un video, y tienes 30 días de soporte incluidos.",
	},
];

// Preguntas frecuentes (resumen). La respuesta de datos lleva enlace a la política (Ley 1581).
const preguntas: {
	pregunta: string;
	respuesta: string;
	enlace?: { antes: string; texto: string; href: string };
}[] = [
	{
		pregunta: "¿Necesito saber de tecnología?",
		respuesta: "No. Te explicamos todo en lenguaje sencillo y la solución queda lista para usar.",
	},
	{
		pregunta: "¿Qué pasa en el diagnóstico?",
		respuesta:
			"Conversamos 30 minutos, revisamos tus datos y en 3 días hábiles recibes un informe con lo que se puede automatizar. Es gratis y el informe es tuyo, aunque no trabajes con nosotros.",
	},
	{
		pregunta: "¿Cuánto cuesta?",
		respuesta: "Depende de lo que necesites. Después del diagnóstico te damos un precio claro, antes de empezar.",
	},
	{
		pregunta: "¿Qué pasa con mis datos?",
		respuesta:
			"Firmamos un acuerdo de confidencialidad antes de verlos y los eliminamos al terminar, si así lo prefieres.",
		enlace: { antes: "Más detalles en la", texto: "Política de tratamiento de datos", href: "/politica-de-tratamiento-de-datos" },
	},
];
---

<BaseLayout
	title="Automatiza tu emprendimiento | Analizando y Automatizando"
	description="Deja de perder horas en tareas repetitivas. Ponemos tus reportes y procesos en automático. Empieza con un diagnóstico gratis y sin compromiso."
>
	<section aria-labelledby="hero-titulo" class="hero reticula-horizonte relative isolate overflow-hidden">
		<div class="contenedor py-20 sm:py-28 lg:py-32">
			<h1 id="hero-titulo">
				Analizamos lo que tienes. <span class="degradado-amanecer block">Automatizamos lo que repites.</span>
			</h1>

			<p class="mt-6 max-w-2xl text-lg text-texto-2 sm:text-xl">
				Ayudamos a emprendimientos emergentes a dejar de perder horas en tareas repetitivas, con soluciones a la
				medida y sin jerga técnica.
			</p>

			<div class="mt-10 flex flex-col items-start gap-3">
				<Button href="/agendar">Agenda tu diagnóstico gratis</Button>
				<p class="text-sm text-texto-2">Gratis · informe en 3 días hábiles</p>
			</div>
		</div>
	</section>

	{/* 1. Problema que resolvemos: frases sueltas en una lista, sin títulos (ver Card) */}
	<Seccion id="problema" titulo="¿Tu negocio crece, pero tu tiempo no alcanza?">
		<ul class="grid gap-6 md:grid-cols-3">
			<li>
				<Card etiqueta="div" class="h-full">
					<MessageCircle slot="icono" stroke-width={1.5} size={28} />
					<p class="text-texto">Pasas los pedidos de WhatsApp a una hoja de cálculo, uno por uno.</p>
				</Card>
			</li>
			<li>
				<Card etiqueta="div" class="h-full">
					<FileSpreadsheet slot="icono" stroke-width={1.5} size={28} />
					<p class="text-texto">Armas el reporte del mes a mano y te quita horas que necesitas para vender.</p>
				</Card>
			</li>
			<li>
				<Card etiqueta="div" class="h-full">
					<Files slot="icono" stroke-width={1.5} size={28} />
					<p class="text-texto">Tienes los números en varios archivos y ninguno cuadra con el otro.</p>
				</Card>
			</li>
		</ul>
		<p class="mt-10 text-lg text-texto-2">
			Esas tareas se pueden hacer solas. Tú decides; el trabajo repetitivo lo hacen tus sistemas.
		</p>
	</Seccion>

	{/* 2. Servicios: cian = análisis, magenta = automatización, violeta = predictivo (IA) */}
	<Seccion id="servicios" titulo="Lo que hacemos por tu emprendimiento">
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			<Card titulo="Diagnóstico de datos" href="/servicios/diagnostico-de-datos" acento="cian">
				<ClipboardCheck slot="icono" stroke-width={1.5} size={28} />
				<p>Te mostramos dónde se te van las horas y qué conviene automatizar primero.</p>
			</Card>
			<Card titulo="Tableros" href="/servicios/tableros" acento="cian">
				<LayoutDashboard slot="icono" stroke-width={1.5} size={28} />
				<p>Tus números clave en una sola pantalla, actualizados solos.</p>
			</Card>
			<Card
				titulo="Limpieza y consolidación de datos"
				href="/servicios/limpieza-y-consolidacion-de-datos"
				acento="cian"
			>
				<Combine slot="icono" stroke-width={1.5} size={28} />
				<p>Juntamos tus hojas de cálculo y archivos en una sola fuente que sí cuadra.</p>
			</Card>
			<Card
				titulo="Automatización de reportes y procesos"
				href="/servicios/automatizacion-de-reportes"
				acento="magenta"
			>
				<Workflow slot="icono" stroke-width={1.5} size={28} />
				<p>Tus reportes listos cada lunes, sin que tengas que armarlos.</p>
			</Card>
			<Card titulo="Análisis predictivo" href="/servicios/analisis-predictivo" acento="violeta">
				<TrendingUp slot="icono" stroke-width={1.5} size={28} />
				<p>Cuando tus datos lo permiten, te ayudamos a anticipar ventas e inventario.</p>
			</Card>
		</div>
	</Seccion>

	{/* 3. Cómo trabajamos: tubería de 5 etapas (estática; el pulso de luz va con los efectos) + 4 pasos */}
	<Seccion id="como-trabajamos" titulo="Del caos a tus procesos en automático, en cuatro pasos">
		<ol aria-label="Nuestro método, en cinco etapas" class="flex flex-wrap items-center gap-x-2 gap-y-3">
			{
				etapas.map((etapa, i) => (
					<li class="flex items-center gap-2">
						{i > 0 && <ChevronRight size={18} stroke-width={1.5} class="text-texto-tenue" />}
						<span
							class:list={[
								"inline-flex min-h-9 items-center rounded-full border px-4 font-mono text-[0.8125rem] tracking-[0.08em] uppercase",
								i === etapas.length - 1 ? "border-lima text-lima" : "border-borde-fuerte text-texto-2",
							]}
						>
							{etapa}
						</span>
					</li>
				))
			}
		</ol>

		<ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				pasos.map(({ titulo, texto }, i) => (
					<li>
						<Card etiqueta="div" titulo={titulo} acento="cian" class="h-full">
							<span slot="icono" aria-hidden="true" class="font-mono text-2xl">
								{String(i + 1).padStart(2, "0")}
							</span>
							<p>{texto}</p>
						</Card>
					</li>
				))
			}
		</ol>

		<EnlaceFlecha href="/como-trabajamos" class="mt-10">Ver tiempos y acompañamiento</EnlaceFlecha>
	</Seccion>

	{/* 4. Demos: oculta hasta la Fase 6 · 5. Calculadora de ahorro: plan propio (va aquí, antes de Quiénes somos) */}

	{/* 6. Quiénes somos: texto + cita destacada con barra Horizonte (cian → lima: 2 neones) */}
	<Seccion id="quienes-somos" titulo="Desde 2022, convirtiendo tecnología en claridad">
		<div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
			<div>
				<p class="text-lg text-texto-2">
					Escuchamos primero, analizamos con rigor y automatizamos solo lo que de verdad libera tiempo.
				</p>
				<EnlaceFlecha href="/sobre-nosotros" class="mt-6">Conócenos</EnlaceFlecha>
			</div>

			<figure class="cita relative pl-6 sm:pl-8">
				<Quote size={32} stroke-width={1.5} class="mb-4 text-cian" />
				<blockquote>
					<p class="font-titulo text-2xl leading-snug font-medium text-texto sm:text-3xl">
						Cada dato cuenta una historia. Nosotros te ayudamos a escucharla y a escribir el siguiente capítulo.
					</p>
				</blockquote>
			</figure>
		</div>
	</Seccion>

	{/* 7. Preguntas frecuentes: acordeón nativo (<details>), funciona con teclado y sin JavaScript */}
	<Seccion id="preguntas" titulo="Preguntas frecuentes">
		<div class="max-w-3xl divide-y divide-borde border-y border-borde">
			{
				preguntas.map(({ pregunta, respuesta, enlace }) => (
					<details class="pregunta">
						<summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-4 font-titulo text-lg font-medium text-texto hover:text-cian">
							{pregunta}
							<Plus size={24} stroke-width={1.5} class="icono-pregunta shrink-0 text-texto-2" />
						</summary>
						<p class="pr-10 pb-6 text-texto-2">
							{respuesta}
							{enlace && (
								<>
									{" "}
									{enlace.antes}{" "}
									<a href={enlace.href} class="underline underline-offset-4">
										{enlace.texto}
									</a>
									.
								</>
							)}
						</p>
					</details>
				))
			}
		</div>
	</Seccion>

	{/* 8. Llamado final: panel que repite la Aurora y la retícula del hero, como cierre de la página */}
	<section aria-labelledby="cierre-titulo" class="py-10 sm:py-12 lg:py-16">
		<div class="contenedor">
			<div
				class="cierre reticula-horizonte relative isolate overflow-hidden rounded-(--radio-tarjeta) border border-borde px-6 py-16 text-center sm:px-12 lg:py-24"
			>
				<h2 id="cierre-titulo" class="mx-auto max-w-2xl">Tu primer paso son 30 minutos</h2>
				<p class="mx-auto mt-4 max-w-xl text-lg text-texto-2">
					Cuéntanos qué tareas te quitan tiempo y te decimos qué se puede automatizar.
				</p>
				<div class="mt-8 flex justify-center">
					<Button href="/agendar">Agenda tu diagnóstico gratis</Button>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	/* Fondo Aurora (marca.md §2.3); cambia sola con el tema */
	.hero {
		background-image: var(--grad-aurora);
	}

	/* Retícula de horizonte (marca.md §5): cuadrícula en perspectiva que se pierde hacia el fondo.
	   Decorativa y estática. Se usa en el hero y en el panel de cierre (necesitan relative + isolate). */
	.reticula-horizonte::before {
		content: "";
		position: absolute;
		inset-inline: -50%;
		bottom: 0;
		height: 45%;
		z-index: -1;
		background-image:
			linear-gradient(to right, var(--borde) 1px, transparent 1px),
			linear-gradient(to bottom, var(--borde) 1px, transparent 1px);
		background-size: 56px 56px;
		transform: perspective(360px) rotateX(62deg);
		transform-origin: bottom;
		mask-image: linear-gradient(to top, black 10%, transparent 90%);
		opacity: 0.5;
		pointer-events: none;
	}

	/* Desvanecido inferior: el hero se funde con el fondo en vez de cortarse en línea recta.
	   Va en ::after para pintarse encima de la retícula. */
	.hero::after {
		content: "";
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		height: 12%;
		z-index: -1;
		background-image: linear-gradient(to bottom, transparent, var(--fondo));
		pointer-events: none;
	}

	/* Cita de «Quiénes somos»: barra vertical de crecimiento (cian → lima, versión vertical de Horizonte) */
	.cita::before {
		content: "";
		position: absolute;
		inset-block: 0;
		left: 0;
		width: 3px;
		border-radius: 999px;
		background-image: linear-gradient(to bottom, var(--cian), var(--lima));
	}

	/* Preguntas frecuentes: sin el triángulo del navegador; el + gira hasta ser × al abrir */
	.pregunta summary::-webkit-details-marker {
		display: none;
	}

	.icono-pregunta {
		transition:
			rotate 300ms var(--curva),
			color 150ms var(--curva);
	}

	.pregunta[open] .icono-pregunta {
		rotate: 45deg;
		color: var(--cian);
	}

	/* Panel de cierre: superficie + Aurora, como un eco del hero */
	.cierre {
		background-color: var(--superficie);
		background-image: var(--grad-aurora);
	}

	/* Degradado Amanecer neón solo en el titular corto (≤ 4 palabras, marca.md §2.3) */
	.degradado-amanecer {
		background-image: var(--grad-amanecer);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
</style>
