---
import {
	ChevronRight,
	FileSpreadsheet,
	Files,
	MessageCircle,
} from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Calculadora from "../components/Calculadora.astro";
import Cita from "../components/Cita.astro";
import LlamadoFinal from "../components/LlamadoFinal.astro";
import MotorScroll from "../components/MotorScroll.astro";
import PreguntasFrecuentes, { type Pregunta } from "../components/PreguntasFrecuentes.astro";
import Card from "../components/Card.astro";
import DatosEstructurados from "../components/DatosEstructurados.astro";
import { esquemaNegocio } from "../lib/schema";
import EnlaceFlecha from "../components/EnlaceFlecha.astro";
import EscenaCierre from "../components/EscenaCierre.astro";
import HeroAmanecer from "../components/HeroAmanecer.astro";
import Seccion from "../components/Seccion.astro";
import { servicios } from "../lib/servicios";
// Textos de docs/contenido.md (Inicio, aprobados).
// Demos: ocultas hasta la Fase 6.

// «Cómo trabajamos»: la tubería muestra el método; los pasos, el camino del cliente.
const etapas = ["Datos", "Limpieza", "Análisis", "Automatización", "Decisión"];
const pasos = [
	{
		titulo: "Diagnóstico gratis",
		texto: "Conversamos 30 minutos, revisamos tus datos y en 3 días hábiles te entregamos un informe con lo que conviene automatizar.",
	},
	{
		titulo: "Propuesta clara",
		texto: "Te enviamos un plan con lo que vamos a hacer, cuánto tarda y cuánto cuesta. Sin letra pequeña.",
	},
	{
		titulo: "Construcción",
		texto: "Armamos la solución con las herramientas que ya usas, siempre que se pueda.",
	},
	{
		titulo: "Entrega y acompañamiento",
		texto: "Te capacitamos, te dejamos un manual y un video, y tienes 30 días de soporte incluidos.",
	},
];

// Preguntas frecuentes (resumen). La respuesta de datos lleva enlace a la política (Ley 1581).
const preguntas: Pregunta[] = [
	{
		pregunta: "¿Necesito saber de tecnología?",
		respuesta: "No. Te explicamos todo en lenguaje sencillo y la solución queda lista para usar.",
	},
	{
		pregunta: "¿Qué pasa en el diagnóstico?",
		respuesta:
			"Conversamos 30 minutos, revisamos tus datos y en 3 días hábiles recibes un informe con lo que se puede automatizar. Es gratis y el informe es tuyo, aunque no trabajes con nosotros.",
	},
	{
		pregunta: "¿Cuánto cuesta?",
		respuesta: "Depende de lo que necesites. Después del diagnóstico te damos un precio claro, antes de empezar.",
	},
	{
		pregunta: "¿Qué pasa con mis datos?",
		respuesta:
			"Firmamos un acuerdo de confidencialidad antes de verlos y los eliminamos al terminar, si así lo prefieres.",
		enlace: { antes: "Más detalles en la", texto: "Política de tratamiento de datos", href: "/politica-de-tratamiento-de-datos" },
	},
];
---

<BaseLayout
	title="Automatiza tu emprendimiento | Analizando y Automatizando"
	description="Deja de perder horas en tareas repetitivas. Ponemos tus reportes y procesos en automático. Empieza con un diagnóstico gratis y sin compromiso."
	encabezadoSobrepuesto
>
	<DatosEstructurados slot="head" datos={esquemaNegocio} />

	{/* Hero: escena «Amanecer» sostenida con el scroll (componente HeroAmanecer, docs/scroll.md) */}
	<HeroAmanecer />

	{/* 1. Problema que resolvemos: frases sueltas en una lista, sin títulos (ver Card) */}
	<Seccion id="problema" titulo="¿Tu negocio crece, pero tu tiempo no alcanza?">
		<ul class="grid gap-6 md:grid-cols-3" data-sc-in data-sc-stagger="90">
			<li>
				<Card etiqueta="div" class="h-full">
					<MessageCircle slot="icono" stroke-width={1.5} size={28} />
					<p class="text-texto">Pasas los pedidos de WhatsApp a una hoja de cálculo, uno por uno.</p>
				</Card>
			</li>
			<li>
				<Card etiqueta="div" class="h-full">
					<FileSpreadsheet slot="icono" stroke-width={1.5} size={28} />
					<p class="text-texto">Armas el reporte del mes a mano y te quita horas que necesitas para vender.</p>
				</Card>
			</li>
			<li>
				<Card etiqueta="div" class="h-full">
					<Files slot="icono" stroke-width={1.5} size={28} />
					<p class="text-texto">Tienes los números en varios archivos y ninguno cuadra con los demás.</p>
				</Card>
			</li>
		</ul>
		<p class="mt-10 text-lg text-texto-2">
			Esas tareas se pueden hacer solas. Tú decides; el trabajo repetitivo lo hacen tus sistemas.
		</p>
	</Seccion>

	{/* 2. Servicios: datos en src/lib/servicios.ts (también los usa /servicios) */}
	<Seccion id="servicios" titulo="Lo que hacemos por tu emprendimiento">
		{/* Cada tarjeta va envuelta: la aparición se anima en el envoltorio, porque la transición propia
		    de Card (glow) tiene más prioridad que la del motor y la haría aparecer de golpe. */}
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-sc-in data-sc-stagger="70">
			{
				servicios.map(({ titulo, href, acento, icono: Icono, texto }) => (
					<div>
						<Card titulo={titulo} href={href} acento={acento} luz class="h-full">
							<Icono slot="icono" stroke-width={1.5} size={28} />
							<p>{texto}</p>
						</Card>
					</div>
				))
			}
		</div>
	</Seccion>

	{/* 3. Cómo trabajamos · MOMENTO CUMBRE (docs/scroll.md): la tubería se sostiene en pantalla y un pulso de
	    datos la recorre al ritmo del scroll. El pulso es solo CSS y lee --sc-p (progreso del acto, 0 → 1). */}
	<section id="como-trabajamos" aria-labelledby="como-trabajamos-titulo">
		<div data-sc-act="pin" data-sc-span="2" class="tuberia-acto">
			<div data-sc-stage class="flex min-h-dvh items-center">
				<div class="contenedor">
					<h2 id="como-trabajamos-titulo" class="max-w-3xl">Del caos a tus procesos en automático, en cuatro pasos</h2>
					<ol aria-label="Nuestro método, en cinco etapas" class="mt-10 flex flex-wrap items-center gap-x-2 gap-y-3">
						{
							etapas.map((etapa, i) => (
								<li class="flex items-center gap-2">
									{i > 0 && <ChevronRight size={18} stroke-width={1.5} class="text-texto-tenue" />}
									<span
										data-i={i}
										class:list={[
											"etapa inline-flex min-h-9 items-center rounded-full border px-4 font-mono text-[0.8125rem] tracking-[0.08em] uppercase",
											i === etapas.length - 1 && "etapa--final",
										]}
									>
										{etapa}
									</span>
								</li>
							))
						}
					</ol>
					<div class="pulso mt-8 max-w-3xl" aria-hidden="true"><span class="pulso__luz"></span></div>
				</div>
			</div>
		</div>

		<div class="contenedor pb-10 sm:pb-12 lg:pb-16">
			<ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-sc-in data-sc-stagger="90">
				{
					pasos.map(({ titulo, texto }, i) => (
						<li>
							<Card etiqueta="div" titulo={titulo} acento="cian" class="h-full">
								<span slot="icono" aria-hidden="true" class="font-mono text-2xl">
									{String(i + 1).padStart(2, "0")}
								</span>
								<p>{texto}</p>
							</Card>
						</li>
					))
				}
			</ol>

			<EnlaceFlecha href="/como-trabajamos" class="mt-10">Ver tiempos y acompañamiento</EnlaceFlecha>
		</div>
	</section>

	{/* 4. Demos: oculta hasta la Fase 6 */}

	{/* 6. Quiénes somos: texto + cita destacada con barra Horizonte (cian → lima: 2 neones) */}
	<Seccion id="quienes-somos" titulo="Desde 2022, convirtiendo tecnología en claridad">
		<div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
			<div>
				<p class="text-lg text-texto-2">
					Escuchamos primero, analizamos con rigor y automatizamos solo lo que de verdad libera tiempo.
				</p>
				<EnlaceFlecha href="/sobre-nosotros" class="mt-6">Conócenos</EnlaceFlecha>
			</div>

			{/* Cortina (docs/scroll.md): la cita se descubre de izquierda a derecha mientras entra en pantalla */}
			<div data-sc-act="flow">
				<div data-sc-reveal="right" data-sc-reveal-at="0.15 0.45">
					<Cita texto="Cada dato cuenta una historia. Nosotros te ayudamos a escucharla y a escribir el siguiente capítulo." />
				</div>
			</div>
		</div>
	</Seccion>

	{/* 7. Preguntas frecuentes: acordeón nativo (componente PreguntasFrecuentes) */}
	<PreguntasFrecuentes preguntas={preguntas} />

	{/* 5. Calculadora de ahorro: justo antes del llamado final (marca.md §6.1), su resultado lleva al cierre */}
	<Calculadora />

	{/* 8. Llamado final: panel con Aurora y retícula, eco del hero (texto por defecto del componente) */}
	{/* Cierre: el sol termina de salir (EscenaCierre, plan «Amanecer» paso 3) */}
	<LlamadoFinal>
		<EscenaCierre slot="escena" />
	</LlamadoFinal>

	<MotorScroll />
</BaseLayout>

<style>
	/* Pulso de datos (momento cumbre). --avance = progreso del acto sostenido.
	   Sin JavaScript --sc-p no existe y vale 1: la tubería se ve encendida completa. Igual con «reducir movimiento». */
	.tuberia-acto {
		--avance: var(--sc-p, 1);
	}

	@media (prefers-reduced-motion: reduce) {
		.tuberia-acto {
			--avance: 1;
		}
	}

	/* Cada etapa se enciende cuando el pulso llega a ella (--i = su posición, de 0 a 4).
	   La posición va en data-i y no en style="…": la CSP del sitio bloquea los estilos en línea. */
	.etapa[data-i="1"] {
		--i: 1;
	}
	.etapa[data-i="2"] {
		--i: 2;
	}
	.etapa[data-i="3"] {
		--i: 3;
	}
	.etapa[data-i="4"] {
		--i: 4;
	}
	.etapa {
		--i: 0;
		--encendido: clamp(0, calc((var(--avance) * 5 - var(--i)) * 2), 1);
		border-color: color-mix(in oklab, var(--cian) calc(var(--encendido) * 100%), var(--borde-fuerte));
		color: color-mix(in oklab, var(--texto) calc(var(--encendido) * 100%), var(--texto-2));
	}

	/* «Decisión»: el resultado, en lima (marca.md §2.1: crecimiento y resultados positivos) */
	.etapa--final {
		border-color: color-mix(in oklab, var(--lima) calc(var(--encendido) * 100%), var(--borde-fuerte));
		color: color-mix(in oklab, var(--lima) calc(var(--encendido) * 100%), var(--texto-2));
	}

	/* Barra de progreso con el degradado Horizonte (cian → lima) y un punto de luz en la punta */
	.pulso {
		position: relative;
		height: 2px;
		border-radius: 999px;
		background-color: var(--borde);
	}

	.pulso::before {
		content: "";
		position: absolute;
		inset-block: 0;
		left: 0;
		width: calc(var(--avance) * 100%);
		border-radius: inherit;
		background-image: var(--grad-horizonte);
	}

	.pulso__luz {
		position: absolute;
		top: 50%;
		left: calc(var(--avance) * 100%);
		width: 10px;
		height: 10px;
		border-radius: 999px;
		background-color: var(--cian);
		box-shadow: var(--glow-cian);
		translate: -50% -50%;
	}
</style>
