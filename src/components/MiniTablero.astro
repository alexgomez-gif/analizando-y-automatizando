---
/**
 * Mini tablero en vivo (marca.md §6.1): muestra lo que el cliente recibirá.
 * - Tres indicadores que cuentan hacia arriba y una gráfica que se dibuja cuando el tablero entra en
 *   pantalla, una sola vez. Todas las cifras son de ejemplo y lo dice en pantalla (marca.md §7).
 * - El HTML ya trae las cifras finales: sin JavaScript o con «reducir movimiento» se ve completo y quieto.
 *   El lector de pantalla siempre lee la cifra final (la que cuenta está oculta para él).
 * - La gráfica tiene su tabla de datos para lectores de pantalla (CLAUDE.md §7).
 * - Con mouse se inclina máx. 4° y una luz sigue al cursor, como Card con `luz` (motor de scroll-craft).
 * - `class` va en el envoltorio: el componente que lo usa lo coloca y lo mueve con el scroll, y la
 *   inclinación del motor queda en la tarjeta de adentro (cada una tiene su propio transform).
 */
interface Props {
	class?: string;
}

const { class: claseExtra } = Astro.props;

const formato = new Intl.NumberFormat("es-CO");
const formatoMillones = new Intl.NumberFormat("es-CO", { minimumFractionDigits: 1, maximumFractionDigits: 2 });

// Datos de ejemplo (aprobados con el prototipo «Amanecer» del 2026-10-21). Orden de colores de marca.md §2.5.
const indicadores = [
	{ etiqueta: "Ventas del mes", valor: 48_250_000, prefijo: "$", color: "text-cian" },
	{ etiqueta: "Pedidos", valor: 312, prefijo: "", color: "text-magenta" },
	{ etiqueta: "Clientes nuevos", valor: 46, prefijo: "", color: "text-lima" },
];

// Ventas de enero a septiembre, en millones de pesos. Septiembre coincide con «Ventas del mes».
const ventas = [
	{ mes: "Enero", millones: 31.2 },
	{ mes: "Febrero", millones: 33.4 },
	{ mes: "Marzo", millones: 32.6 },
	{ mes: "Abril", millones: 37.1 },
	{ mes: "Mayo", millones: 36.3 },
	{ mes: "Junio", millones: 40.2 },
	{ mes: "Julio", millones: 39.5 },
	{ mes: "Agosto", millones: 44.1 },
	{ mes: "Septiembre", millones: 48.25 },
];

// Gráfica en un lienzo de 400 × 120: la escala vertical va de 28 a 50 millones.
const [ancho, alto, minimo, maximo] = [400, 120, 28, 50];
const puntos = ventas.map(({ millones }, i) => {
	const x = (i * ancho) / (ventas.length - 1);
	const y = 110 - ((millones - minimo) / (maximo - minimo)) * 90;
	return `${x} ${y.toFixed(1)}`;
});
const linea = `M${puntos.join(" L")}`;
const area = `${linea} L${ancho} ${alto} L0 ${alto} Z`;
// Eje: un mes de por medio, alineados con los puntos 0, 2, 4, 6 y 8.
const eje = ventas.filter((_, i) => i % 2 === 0).map(({ mes }) => mes.slice(0, 3).toUpperCase());
---

<div class={claseExtra}>
	<figure
		data-tablero
		data-sc-tilt="4"
		data-sc-spotlight
		class="tablero relative overflow-hidden rounded-(--radio-tarjeta) border border-borde bg-cristal p-5 backdrop-blur-[16px] sm:p-6"
	>
		<figcaption class="flex flex-wrap items-center justify-between gap-2">
			<span class="font-titulo text-[1.0625rem] font-bold text-texto">Tu negocio, hoy</span>
			<span
				class="rounded-full border border-ambar/45 bg-superficie/80 px-2.5 font-mono text-[0.75rem] tracking-[0.08em] text-ambar uppercase"
			>
				Datos de ejemplo
			</span>
		</figcaption>

		{/* Chip y cajas de cifras con fondo casi opaco: el vidrio deja pasar el sol de la escena y, sin ese
		    fondo, el ámbar y el cian del tema claro bajaban de 4,5:1 (medido con píxeles reales). */}
		<dl class="mt-4 grid grid-cols-[1.4fr_1fr_1fr] gap-2">
			{
				indicadores.map(({ etiqueta, valor, prefijo, color }) => (
					<div class="rounded-[10px] border border-borde bg-fondo/80 px-3 py-2.5">
						<dt class="text-xs leading-snug text-texto-2">{etiqueta}</dt>
						<dd class:list={["mt-1 font-mono text-[0.9375rem] leading-snug font-medium tabular-nums", color]}>
							<span aria-hidden="true" data-cuenta={valor} data-prefijo={prefijo}>
								{`${prefijo}${formato.format(valor)}`}
							</span>
							<span class="sr-only">{`${prefijo}${formato.format(valor)}`}</span>
						</dd>
					</div>
				))
			}
		</dl>

		<div class="mt-4">
			<svg viewBox={`0 0 ${ancho} ${alto}`} preserveAspectRatio="none" aria-hidden="true" class="block h-24 w-full overflow-visible sm:h-28">
				<defs>
					<linearGradient id="tablero-degradado-linea" x1="0" x2="1">
						<stop offset="0" class="parada parada--cian"></stop>
						<stop offset="0.5" class="parada parada--violeta"></stop>
						<stop offset="1" class="parada parada--magenta"></stop>
					</linearGradient>
					<linearGradient id="tablero-degradado-area" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0" class="parada parada--area"></stop>
						<stop offset="1" class="parada parada--area-fin"></stop>
					</linearGradient>
				</defs>
				<g class="rejilla">
					<line x1="0" y1="30" x2={ancho} y2="30"></line>
					<line x1="0" y1="60" x2={ancho} y2="60"></line>
					<line x1="0" y1="90" x2={ancho} y2="90"></line>
				</g>
				<path class="area" d={area}></path>
				<path class="linea" pathLength="1" d={linea}></path>
			</svg>
			<div aria-hidden="true" class="mt-2 flex justify-between font-mono text-[0.75rem] tracking-[0.06em] text-texto-tenue">
				{eje.map((mes) => <span>{mes}</span>)}
			</div>

			<table class="sr-only">
				<caption>Ventas por mes, en millones de pesos (datos de ejemplo)</caption>
				<thead>
					<tr><th scope="col">Mes</th><th scope="col">Ventas</th></tr>
				</thead>
				<tbody>
					{
						ventas.map(({ mes, millones }) => (
							<tr><th scope="row">{mes}</th><td>{formatoMillones.format(millones)}</td></tr>
						))
					}
				</tbody>
			</table>
		</div>
	</figure>
</div>

<style>
	/* Sombra que separa la tarjeta de la escena; en el tema claro, una sombra suave con el color del texto */
	.tablero {
		box-shadow:
			0 30px 60px -20px color-mix(in srgb, var(--fondo) 85%, transparent),
			inset 0 1px 0 color-mix(in srgb, var(--texto) 8%, transparent);
		/* Aparece justo después del titular (300 ms, marca.md §6.2) */
		animation: entrar 700ms 250ms var(--curva) both;
	}

	:global(:root[data-theme="light"]) .tablero {
		box-shadow:
			0 24px 48px -24px color-mix(in srgb, var(--texto) 30%, transparent),
			inset 0 1px 0 color-mix(in srgb, var(--superficie) 80%, transparent);
	}

	@keyframes entrar {
		from {
			opacity: 0;
			translate: 0 16px;
		}
	}

	/* Gráfica: rejilla en --borde al 50 % (marca.md §2.5), línea con el degradado Amanecer y área en violeta */
	.rejilla line {
		stroke: var(--borde);
		stroke-opacity: 0.5;
	}

	.parada--cian {
		stop-color: var(--cian);
	}
	.parada--violeta {
		stop-color: var(--violeta);
	}
	.parada--magenta {
		stop-color: var(--magenta);
	}
	.parada--area {
		stop-color: var(--violeta);
		stop-opacity: 0.35;
	}
	.parada--area-fin {
		stop-color: var(--violeta);
		stop-opacity: 0;
	}

	.area {
		fill: url(#tablero-degradado-area);
	}

	.linea {
		fill: none;
		stroke: url(#tablero-degradado-linea);
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		/* Con pathLength="1", un trazo y un hueco del largo de la línea: el desfase la oculta o la muestra */
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
	}

	/* El script pone «espera» al cargar y «vivo» cuando el tablero entra en pantalla.
	   Sin script (o con «reducir movimiento») no hay estado: la gráfica se ve completa. */
	.tablero[data-estado="espera"] .linea {
		stroke-dashoffset: 1;
	}
	.tablero[data-estado="espera"] .area {
		opacity: 0;
	}
	.tablero[data-estado="vivo"] .linea {
		animation: dibujar 1.6s 250ms var(--curva) both;
	}
	.tablero[data-estado="vivo"] .area {
		animation: aparecer 800ms 1.4s var(--curva) both;
	}

	@keyframes dibujar {
		from {
			stroke-dashoffset: 1;
		}
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes aparecer {
		from {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tablero {
			animation: none;
		}
	}
</style>

<script>
	// Cifras que cuentan y gráfica que se dibuja cuando el tablero entra en pantalla (una sola vez).
	// Con «reducir movimiento» no hace nada: el tablero ya está completo en el HTML (marca.md §6.2).
	const reducir = matchMedia("(prefers-reduced-motion: reduce)").matches;
	const formato = new Intl.NumberFormat("es-CO");

	if (!reducir && "IntersectionObserver" in window) {
		for (const tablero of document.querySelectorAll<HTMLElement>("[data-tablero]")) {
			const cifras = [...tablero.querySelectorAll<HTMLElement>("[data-cuenta]")];
			const pintar = (cifra: HTMLElement, valor: number) => {
				cifra.textContent = `${cifra.dataset.prefijo ?? ""}${formato.format(Math.round(valor))}`;
			};

			tablero.dataset.estado = "espera";
			for (const cifra of cifras) pintar(cifra, 0);

			const observador = new IntersectionObserver(
				(entradas) => {
					if (!entradas.some((entrada) => entrada.isIntersecting)) return;
					observador.disconnect();
					tablero.dataset.estado = "vivo";

					// 1,4 s con frenado suave, en sincronía con el trazo de la gráfica (empieza a los 250 ms)
					const inicio = performance.now() + 250;
					const cuadro = (ahora: number) => {
						const avance = Math.min(1, Math.max(0, (ahora - inicio) / 1400));
						const suave = 1 - (1 - avance) ** 3;
						for (const cifra of cifras) pintar(cifra, Number(cifra.dataset.cuenta) * suave);
						if (avance < 1) requestAnimationFrame(cuadro);
					};
					requestAnimationFrame(cuadro);
				},
				{ threshold: 0.5 },
			);
			observador.observe(tablero);
		}
	}
</script>
