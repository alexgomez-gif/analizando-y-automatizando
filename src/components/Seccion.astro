---
/**
 * Sección de página: contenedor, espaciado vertical de marca y un título h2.
 * - Espaciado (marca.md §5): el aire ENTRE secciones es 80 px en celular, 96 px en tablet y 128 px
 *   en escritorio. Cada sección pone la mitad arriba y la mitad abajo; al apilarse suman eso.
 * - La sección se nombra con su propio título (`aria-labelledby`), así los lectores de pantalla
 *   pueden listarla como región y saltar entre secciones.
 * - `id` sirve también como ancla (ej. /#como-trabajamos).
 */
interface Props {
	id: string;
	titulo: string;
	intro?: string;
	class?: string;
}

const { id, titulo, intro, class: claseExtra } = Astro.props;
const idTitulo = `${id}-titulo`;
---

<section id={id} aria-labelledby={idTitulo} class:list={["py-10 sm:py-12 lg:py-16", claseExtra]}>
	<div class="contenedor">
		<h2 id={idTitulo} class="max-w-3xl">{titulo}</h2>
		{intro && <p class="mt-4 text-lg text-texto-2">{intro}</p>}
		<div class="mt-10 sm:mt-12">
			<slot />
		</div>
	</div>
</section>
