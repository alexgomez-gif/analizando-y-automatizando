---
/**
 * Plantilla de las páginas legales (Política de tratamiento de datos, Aviso de privacidad, Términos).
 * CLAUDE.md §10: Claude NO redacta textos legales. Esta plantilla solo crea la estructura:
 * cada sección lleva una nota [REVISIÓN LEGAL PENDIENTE] con lo que debe ir ahí.
 * Estilo sobrio (marca.md §7): sin Aurora, sin glow, sin degradados y sin panel de cierre.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import CabeceraPagina from "./CabeceraPagina.astro";

interface Props {
	title: string;
	description: string;
	titulo: string;
	secciones: { titulo: string; pendiente: string }[];
}

const { title, description, titulo, secciones } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<CabeceraPagina titulo={titulo} migas={[{ texto: "Inicio", href: "/" }, { texto: titulo }]} sobria />

	<div class="contenedor pb-10 sm:pb-12 lg:pb-16">
		<div class="max-w-3xl">
			{/* Aviso visible mientras el documento no tenga su texto definitivo */}
			<div class="rounded-(--radio-tarjeta) border-2 border-dashed border-ambar p-6">
				<p class="font-mono text-[0.8125rem] tracking-[0.08em] text-ambar uppercase">Documento en construcción</p>
				<p class="mt-2 text-texto">
					[REVISIÓN LEGAL PENDIENTE] El texto definitivo lo redacta o revisa un profesional antes de publicar el sitio.
				</p>
				<p class="mt-2 text-sm text-texto-2">Última actualización: [PENDIENTE]</p>
			</div>

			<ol class="mt-12 space-y-10">
				{
					secciones.map(({ titulo: tituloSeccion, pendiente }, i) => (
						<li>
							<h2 class="text-[1.75rem]">
								<span class="mr-2 font-mono text-texto-2">{i + 1}.</span>
								{tituloSeccion}
							</h2>
							<p class="mt-3 text-texto-2">[REVISIÓN LEGAL PENDIENTE: {pendiente}]</p>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</BaseLayout>
