---
/**
 * Tarjeta «cristal» del sitio (marca.md §5). Todas las tarjetas usan este componente.
 * - Con `href`, toda la tarjeta se puede pulsar, pero el enlace es solo el título: el lector de
 *   pantalla anuncia un nombre corto («Tableros, enlace») en vez de leer el párrafo entero.
 *   Con mouse o foco muestra el borde Amanecer y el glow (clase `tarjeta-enlace`, global.css).
 * - Sin `href`, es una tarjeta informativa y queda quieta.
 * - `acento` colorea el ícono según su significado: cian = análisis, magenta = automatización,
 *   violeta = inteligencia artificial. Sin acento, el ícono va en --texto-2.
 * - Slot `icono`: un ícono de Lucide (decorativo). Slot por defecto: el texto de la tarjeta.
 */
interface Props {
	titulo: string;
	href?: string;
	/** Nivel del título; 3 por defecto (la sección que la contiene usa h2). */
	nivel?: 2 | 3 | 4;
	acento?: "cian" | "magenta" | "violeta";
	class?: string;
}

const { titulo, href, nivel = 3, acento, class: claseExtra } = Astro.props;

const Titulo = `h${nivel}` as "h2" | "h3" | "h4";

const coloresAcento = {
	cian: "text-cian",
	magenta: "text-magenta",
	violeta: "text-violeta",
};
const colorIcono = acento ? coloresAcento[acento] : "text-texto-2";
---

<article
	class:list={[
		"relative rounded-(--radio-tarjeta) border border-borde bg-cristal p-6 backdrop-blur-[14px] transition-shadow duration-150 ease-(--curva)",
		href && "tarjeta-enlace",
		claseExtra,
	]}
>
	{
		Astro.slots.has("icono") && (
			<div class:list={["mb-4", colorIcono]}>
				<slot name="icono" />
			</div>
		)
	}

	<Titulo class="text-[1.375rem] leading-snug">
		{
			href ? (
				<a href={href} class="text-texto no-underline after:absolute after:inset-0">
					{titulo}
				</a>
			) : (
				titulo
			)
		}
	</Titulo>

	<div class="mt-3 text-texto-2">
		<slot />
	</div>
</article>
