# Copia este archivo como .env (local) y llena los valores.
# En producción, estas variables van en la configuración de Cloudflare.
# Nunca escribas valores reales en este archivo.

# Cloudflare Turnstile (anti-spam del formulario)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Correo transaccional — [PENDIENTE: elegir proveedor]
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# CRM — [PENDIENTE: Google Sheets o HubSpot]
CRM_API_KEY=

# Cal.com (agenda del diagnóstico)
PUBLIC_CALCOM_URL=
